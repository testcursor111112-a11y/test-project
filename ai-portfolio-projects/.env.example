# Copy to .env and fill in. Notebooks auto-load this via python-dotenv.

# Project 1 (RAG) + Project 3 (Observability) + Project 5 (Voice reasoning)
OPENAI_API_KEY=sk-...

# Project 1 reranker (optional — falls back to local cross-encoder if absent)
COHERE_API_KEY=

# Project 3 observability (self-hosted Langfuse: docker compose up; or cloud keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Project 5 (Voice)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
